# Database Configuration
DATABASE_URL=postgresql://rfq_user:rfq_password@localhost:5432/rfq_platform
ASYNC_DATABASE_URL=postgresql+asyncpg://rfq_user:rfq_password@localhost:5432/rfq_platform

# Redis Configuration
REDIS_URL=redis://localhost:6379

# API Configuration
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Security
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=43200
ALGORITHM=HS256

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# File Storage
UPLOAD_DIRECTORY=uploads
MAX_FILE_SIZE=104857600
USE_S3=false

# AWS S3 (if USE_S3=true)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# AI/ML Configuration
ML_MODEL_PATH=ml-models
ENABLE_GPU=false
AI_CONFIDENCE_THRESHOLD=0.8

# CAD Processing
CAD_PROCESSING_TIMEOUT=300
ENABLE_3D_VIEWER=true

# Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=RFQ Platform

# Business Configuration
DEFAULT_LABOR_RATE=75.0
DEFAULT_MATERIAL_MARKUP=1.2
DEFAULT_OVERHEAD_RATE=0.15