# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/manufacturing_quotes
POSTGRES_USER=manufacturing_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=manufacturing_quotes
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Application Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Storage Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=50  # MB
ALLOWED_FILE_TYPES=.step,.stp,.stl,.dwg,.dxf,.pdf,.png,.jpg,.jpeg,.tiff

# AWS S3 Configuration (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_BUCKET_NAME=manufacturing-drawings
AWS_REGION=us-east-1

# AI/ML Configuration
ENABLE_GPU=false
MODEL_PATH=models/
TENSORFLOW_LOG_LEVEL=2

# Email Configuration (for quote delivery)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@company.com
SMTP_PASSWORD=your_email_password

# Business Configuration
DEFAULT_OVERHEAD_PERCENTAGE=15
DEFAULT_MARGIN_PERCENTAGE=25
COMPANY_NAME=Your Manufacturing Company
COMPANY_ADDRESS=123 Manufacturing St, City, State 12345
COMPANY_EMAIL=quotes@yourcompany.com
COMPANY_PHONE=+1-555-123-4567

# Development
DEBUG=true
LOG_LEVEL=INFO